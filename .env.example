# Configuración de la App Clínica

# URL de Ollama (por defecto: localhost:11434)
# Cambiar solo si tienes Ollama en otro servidor
VITE_OLLAMA_URL=http://localhost:11434

# Modelo de IA a usar
# Modelos disponibles: llama3.2:1b, llama2, etc.
VITE_OLLAMA_MODEL=llama3.2:1b

# Tiempo máximo de espera para respuestas de IA (ms)
VITE_TIMEOUT=60000
